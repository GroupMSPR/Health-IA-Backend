APP_NAME=Health-AI_Coach
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

COMPOSE_PROJECT_NAME=backend

APP_URL=http://localhost:80
L5_SWAGGER_CONST_HOST=http://localhost:80/api
SANCTUM_STATEFUL_DOMAINS=localhost:5001
FRONTEND_URL=http://localhost:5001
# Comma-separated allowed CORS origins. In production, set this to the real
# frontend origin(s) — do NOT keep localhost.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5001,http://localhost:5173,http://localhost:5174,http://localhost:6000
IA_URL=http://healthai_fastapi:4000
OLLAMA_TIMEOUT=240
ML_SERVICE_TIMEOUT=120

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=healthai_pgsql
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=sail
# DB_PASSWORD=password
# FORWARD_DB_PORT=55432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=healthai_mailcatcher
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@healthai-coach.mspr"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
